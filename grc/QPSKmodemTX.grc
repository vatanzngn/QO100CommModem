- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nStream Continuous Padder - Vatan Z. (v3)\nBurst stream\
      \ in, continuous stream out (zero-padded when no input).\nUses gr.basic_block\
      \ + forecast()=[0] to allow output without input.\n\"\"\"\n\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n    def __init__(self):\n\
      \        gr.basic_block.__init__(\n            self,\n            name='Stream\
      \ Continuous Padder',\n            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n\
      \        )\n        self.fifo = np.array([], dtype=np.complex64)\n\n    def\
      \ forecast(self, noutput_items, ninputs):\n        return [0]\n\n    def general_work(self,\
      \ input_items, output_items):\n        out = output_items[0]\n        n_out\
      \ = len(out)\n\n        if len(input_items) > 0 and len(input_items[0]) > 0:\n\
      \            inp = input_items[0]\n            n_in = len(inp)\n           \
      \ self.fifo = np.append(self.fifo, inp)\n            self.consume(0, n_in)\n\
      \n        fifo_len = len(self.fifo)\n        if fifo_len >= n_out:\n       \
      \     out[:] = self.fifo[:n_out]\n            self.fifo = self.fifo[n_out:]\n\
      \        elif fifo_len > 0:\n            out[:fifo_len] = self.fifo\n      \
      \      out[fifo_len:] = 0\n            self.fifo = np.array([], dtype=np.complex64)\n\
      \        else:\n            out[:] = 0\n\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Stream Continuous Padder', 'blk', [], [('0', 'complex', 1)], [('0',
      'complex', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 736.0]
    rotation: 0
    state: enabled
